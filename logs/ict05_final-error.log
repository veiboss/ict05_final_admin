        window.location = `/admin/API/material/download?type=${encodeURIComponent(type)}&s=${encodeURIComponent(s)}`;
    }
</script>
<script>
    function openPopup(id) {
        // 팝업 열기
        const popup = document.getElementById('popupId');
        popup.classList.add('active');

        // 이 부분에서 id AJAX 요청하거나 데이터 바인딩 수행
        // 예시: 콘솔 출력
        console.log("넘어온 id : " + id);

        // AJAX로 상세 데이터 가져오기
        fetch(`/admin/API/receive/detail/${id}`)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            if (!data) throw new Error('데이터가 없습니다');
            // 1. 주문 정보 바인딩
            document.getElementById('orderCode').textContent = data.orderCode || '';
            document.getElementById('orderDate').textContent = data.orderDate || '';
            document.getElementById('deliveryDate').textContent = data.deliveryDate || '';
            document.getElementById('status').textContent = data.statusDescription || '';
            document.getElementById('priority').textContent = data.purchasePriority || '';

            // 2. 가맹점 정보 바인딩
            document.getElementById('storeName').textContent = data.storeName || '';
            document.getElementById('storeCode').textContent = data.storeId || '';
            document.getElementById('storeLocation').textContent = data.storeLocation || '';
            document.getElementById('totalPrice').textContent = formatCurrency(data.totalPrice || 0);
            document.getElementById('itemCount').textContent = data.totalCount || 0;

            // 3. 특이사항 (textarea)
             document.getElementById('note').value = data.remark || '';

            // 4. 주문 상품 리스트 바인딩
            const tbody = document.getElementById('itemTableBody');
            tbody.innerHTML = '';
            (data.items || []).forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${item.title || ''}</td>
                    <td>${item.materialCategory?.name || ''}</td>
                    <td>${item.detailCount || 0}</td>
                    <td>${formatCurrency(item.detailUnitPrice || 0)}</td>
                    <td>${formatCurrency(item.detailTotalPrice || 0)}</td>
                    <td>${item.inventoryStatusDescription || ''}</td>
                `;
                tbody.appendChild(tr);
            });
        })
        .catch(err => {
            alert('상세정보 불러오기 실패: ' + err.message);
            console.error(err);
        });
    }

    function formatCurrency(amount) {
        if (typeof amount !== 'number') return amount;
        return amount.toLocaleString('ko-KR') + '원';
    }

    // 팝업 닫기 함수 (기존 코드 참고)
    function modalClose(selector) {
        const popup = document.querySelector(selector);
        popup.classList.remove('active');
    }
</script>
</body>
</html>
